rules_version = '2';

// セキュリティルールの設計方針:
//
// 1. teams / games は「読み取り専用の公開データ」。チーム成績や試合日程・結果・AI予想を
//    クライアントから改ざんされないよう、書き込みは管理者(admin custom claim)のみに限定する。
//    管理者クレームは Firebase Admin SDK からしか付与できない(scripts/lottery-set-admin-claim.mjs)
//    ため、通常のユーザーアカウントが自分でこのクレームを得ることはできない。
//
// 2. bets(予想) は「本人としてのみ新規作成できる」。さらに bet_id を必ず
//    "<uid>_<game_id>" という形式に固定させることで、同一ユーザーが同じ試合に
//    複数回予想できてしまう不正(二重予想)をルールレベルでも防止している
//    (アプリ側のトランザクションでも同様のチェックを行っており、二重の防御になっている)。
//    さらに、odds / points_wagered をクライアントの自己申告のまま信用せず、
//    games/{gameId} 側の実際のmarketデータと突き合わせて検証する(詳細は下の【既知の制約】参照)。
//    的中判定(result)の更新は精算処理(admin)のみが行い、ユーザー自身が
//    「不的中」を「的中」に書き換えるような改ざんを防ぐ。
//
// 3. users(ポイント) は「他人のポイントを書き換えられない」ことが最重要。
//    本人による更新は、次の2パターンのどちらかのみ許可する:
//    (a) 予想(bets)・チケット(tickets)購入に伴うポイント消費: total_points と
//        prediction_history だけを、total_pointsを「減らす」方向にのみ更新できる。
//    (b) 交換ショップでの実績解放: total_points と unlocks だけを、
//        shopItemCost() で定義した「正しい価格ぶんだけ正確に」減らす形でのみ更新できる
//        (価格を偽装して安く手に入れることを防ぐ)。
//    - ポイントを増やす操作(的中時の払い戻し・試合中止時の返金)は admin のみ許可する。
//
// 4. draws / tickets(非予想系くじ)は bets と似た考え方だが、1ユーザーが同じくじ回で
//    複数口購入できる点が異なるため、ticket_id は固定フォーマットにしていない
//    (代わりに result=='pending' でのみ作成できることを条件にし、的中判定済みの
//    チケットを新規作成扱いで書き込めないようにしている)。購入時は unit_price を
//    draws側の実際の単価と突き合わせ、対象のくじ回が受付中(open)であることも検証する。
//    draws ドキュメントは admin のみ作成・全体更新できるが、購入時に増える
//    ticket_count / participant_uids の2フィールドだけは、一般ユーザーでも
//    「増やす方向に、かつ1回の更新につき最大10口ぶんまで」のみ更新できる
//    (抽選対象試合や配当テーブルなど、他のフィールドはadmin以外書き換えられない)。
//
// 【本フェーズの既知の制約】
// 現状はクライアント(ブラウザ)から直接Firestoreへ書き込む構成のため、結果反映・精算の
// 実行者はブラウザ上で admin クレームを持つユーザーに限定している。本来は、この精算処理
// 自体をCloud Functions等の信頼された実行環境に移し、クライアントは「結果確定リクエスト」
// を送るだけにする設計がより安全(将来のフェーズでの改善候補)。
//
// 上記に加えて、以下も同じ理由(クライアント直接書き込み)による既知の制約として残っている:
// - bets作成時にodds/points_wageredを検証するようにしたが、「usersドキュメント側で
//   実際に減った金額」と「betsのpoints_wagered」が完全に一致することまではルールだけでは
//   保証できない(同一トランザクション内の別ドキュメントへの書き込みどうしを、ルール側で
//   相互参照することはできないため)。odds偽装は防げるが、理論上は「本来より少ないポイント
//   しか払っていないのに、points_wageredの自己申告額に対する配当を受け取る」余地がまだ残る。
// - draws.ticket_countの加算は1回の更新につき10口までに制限したが、実際に対応する
//   ticketドキュメントが同じ回数だけ作成されたことまでは検証できない(同上の理由)。
// これらを完全に塞ぐには、ポイント消費を伴う書き込み(予想・チケット購入・ショップ交換)を
// すべてCloud Functionsの呼び出し可能関数に移し、クライアントには直接書き込みさせない設計に
// する必要がある。ベータ版の現段階では、odds偽装という最も実害の大きい抜け穴を塞ぐことを
// 優先し、上記の残存リスクはコメントとして明記しておく。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // 交換ショップ(js/shop-items.mjs)のカタログをルール側にも複製したもの。
    // アプリ側でSHOP_ITEMSに商品を追加・値段変更した場合は、必ずこちらも同じ内容に更新すること。
    // 未知のitemIdには -1 (購入不可)を返す。
    function shopItemCost(itemId) {
      return itemId == 'expert_draw' ? 3000 : -1;
    }

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }

    function drawData(drawId) {
      return get(/databases/$(database)/documents/draws/$(drawId)).data;
    }

    // js/lottery-core.mjs の placeBet() と全く同じロジックで、その試合の
    // 実際のmarketデータから見た「正しい」オッズを計算する(bets作成時の偽装防止用)。
    function expectedOdds(gameId, betType, betValue) {
      let game = gameData(gameId);
      return betType == 'winner'
        ? (betValue == game.home_team_id ? game.market.homeOdds : game.market.awayOdds)
        : (betValue.pick == 'over' ? game.market.overOdds : game.market.underOdds);
    }

    match /teams/{teamId} {
      // チームデータは現状コード内(js/lottery-core.mjs)で管理している仮データのため、
      // Firestoreへの書き込みは行わない想定。将来Firestore管理に移す場合に備えてread専用にしておく。
      allow read: if true;
      allow write: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (
        isOwner(uid) && (
          (
            // (a) 予想・チケット購入によるポイント消費。金額の妥当性はbets/ticketsの
            //     createルール側で検証しているので、ここでは「減る方向」であることだけを見る。
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_points', 'prediction_history']) &&
            request.resource.data.total_points < resource.data.total_points
          ) ||
          (
            // (b) 交換ショップでの実績解放。unlocksへ追加される商品IDと、その正しい価格ぶんだけ
            //     total_pointsが減っていることを完全一致で要求する(価格の自己申告を信用しない)。
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_points', 'unlocks']) &&
            request.resource.data.unlocks == resource.data.unlocks.concat(['expert_draw']) &&
            resource.data.total_points - request.resource.data.total_points == shopItemCost('expert_draw')
          )
        )
      );
      allow delete: if false;
    }

    match /bets/{betId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && betId == request.auth.uid + '_' + request.resource.data.game_id
        && request.resource.data.result == 'pending'
        && request.resource.data.bet_type in ['winner', 'total_runs']
        && request.resource.data.points_wagered is int
        && request.resource.data.points_wagered > 0
        && request.resource.data.points_wagered <= 100000
        && gameData(request.resource.data.game_id).status == 'scheduled'
        && request.resource.data.odds == expectedOdds(
             request.resource.data.game_id,
             request.resource.data.bet_type,
             request.resource.data.bet_value
           );
      // 的中判定(result)や賭け内容の更新は精算処理(admin)のみ許可し、
      // ユーザー自身による改ざん(不的中→的中の書き換え等)を防ぐ。
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /draws/{drawId} {
      allow read: if true;
      allow create: if isAdmin();
      // admin は全フィールドを更新できる(くじ回の精算・取消など)。
      // 一般ユーザーは、チケット購入に伴う ticket_count / participant_uids の
      // 加算のみ許可し、対象試合・配当テーブル・ステータスなどは書き換えさせない。
      // 1回の購入(js/lottery-big.htmlのMAX_QTY_PER_PURCHASE=10)を超える一括加算は拒否する。
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticket_count', 'participant_uids']) &&
        request.resource.data.ticket_count is int &&
        request.resource.data.ticket_count > resource.data.ticket_count &&
        request.resource.data.ticket_count <= resource.data.ticket_count + 10
      );
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.result == 'pending'
        && request.resource.data.unit_price is int
        && request.resource.data.unit_price > 0
        && drawData(request.resource.data.draw_id).status == 'open'
        && request.resource.data.unit_price == drawData(request.resource.data.draw_id).unit_price;
      // 的中判定(result/matched_count/payout)の更新は精算処理(admin)のみ許可する。
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
