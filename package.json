{
  "name": "baseball-draft",
  "private": true,
  "version": "0.1.0",
  "description": "NPBドラフト会議シミュレーション(静的サイト本体)＋野球くじ(β)の運用スクリプト",
  "type": "module",
  "scripts": {
    "lottery:seed-games": "node scripts/lottery-seed-games.mjs",
    "lottery:seed-shop-items": "node scripts/lottery-seed-shop-items.mjs",
    "lottery:set-admin": "node scripts/lottery-set-admin-claim.mjs",
    "validate:draft-results": "node scripts/validate-draft-results.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --postcss --minify",
    "build:position-thresholds": "node scripts/position-thresholds/build.mjs",
    "check:position-thresholds": "node scripts/position-thresholds/check.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "firebase-admin": "^12.0.0",
    "playwright-core": "^1.56.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17"
  },
  "browserslist": [
    "defaults",
    "ios_saf >= 14",
    "safari >= 14"
  ]
}
